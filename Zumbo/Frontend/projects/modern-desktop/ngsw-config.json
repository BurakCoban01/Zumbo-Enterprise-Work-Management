{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/modern-desktop/index.html",
  "assetGroups": [
    {
      "name": "desktop-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/modern-desktop/index.html",
          "/modern-desktop/manifest.webmanifest",
          "/modern-desktop/runtime-config.js",
          "/modern-desktop/*.css",
          "/modern-desktop/*.js"
        ]
      }
    },
    {
      "name": "desktop-assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/modern-desktop/shared/**"]
      }
    }
  ]
}
