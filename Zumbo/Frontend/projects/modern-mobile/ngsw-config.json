{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/modern-mobile/index.html",
  "assetGroups": [
    {
      "name": "mobile-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/modern-mobile/index.html",
          "/modern-mobile/manifest.webmanifest",
          "/modern-mobile/runtime-config.js",
          "/modern-mobile/*.css",
          "/modern-mobile/*.js"
        ]
      }
    },
    {
      "name": "mobile-assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/modern-mobile/shared/**"]
      }
    }
  ]
}
