{
  "Persistence": {
    "Provider": "InMemory"
  },
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "Zumbo"
  },
  "Jwt": {
    "Issuer": "Zumbo",
    "Audience": "Zumbo.Clients",
    "SigningKey": "zumbo-development-signing-key-change-me-please-32",
    "AccessTokenMinutes": 30
  },
  "LoginSecurity": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "RateLimiting": {
    "LoginPermitLimit": 10,
    "PasswordResetPermitLimit": 5,
    "ApiPermitLimit": 300,
    "SearchPermitLimit": 60,
    "UploadPermitLimit": 10,
    "RealtimeConnectPermitLimit": 500
  },
  "IdentityBootstrap": {
    "AdminEmails": [],
    "BootstrapToken": null
  },
  "PasswordReset": {
    "ExpiryMinutes": 30,
    "FrontendResetUrl": "http://localhost:5177/#/reset-password"
  },
  "Storage": {
    "Provider": "Local",
    "Local": {
      "RootPath": "storage",
      "PublicBasePath": "/files"
    },
    "Minio": {
      "Endpoint": "http://localhost:9000",
      "AccessKey": "minio",
      "SecretKey": "minio12345",
      "BucketName": "zumbo-attachments",
      "PublicBaseUrl": "http://localhost:9000/zumbo-attachments"
    }
  },
  "Search": {
    "Provider": "InMemory",
    "OpenSearch": {
      "BaseUrl": "http://localhost:9200",
      "IndexName": "zumbo-work-items",
      "NumberOfShards": 1,
      "NumberOfReplicas": 1
    }
  },
  "DistributedLock": {
    "Provider": "InMemory",
    "LeaseSeconds": 30,
    "WaitSeconds": 5,
    "Redis": {
      "ConnectionString": "localhost:6379,abortConnect=false",
      "KeyPrefix": "zumbo:lock:",
      "RetryMilliseconds": 100
    }
  },
  "Realtime": {
    "Backplane": "InMemory",
    "Redis": {
      "ConnectionString": "localhost:6379,abortConnect=false"
    }
  },
  "ReadModelCache": {
    "Provider": "InMemory",
    "TtlSeconds": 30,
    "KeyPrefix": "zumbo:read-model:"
  },
  "DataProtection": {
    "KeyPath": ""
  },
  "Notifications": {
    "Email": {
      "Enabled": false,
      "Host": "localhost",
      "Port": 25,
      "UseSsl": true,
      "FromAddress": "noreply@zumbo.local",
      "FromName": "Zumbo"
    },
    "DueDateReminder": {
      "Enabled": true,
      "HorizonHours": 24,
      "IntervalMinutes": 15
    }
  },
  "BackgroundJobs": {
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "KnownProxies": []
  }
}
