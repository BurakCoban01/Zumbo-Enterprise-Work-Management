# Yalnız yerel geliştirme için örnek değerlerdir. Üretimde secret manager kullanın.
ZUMBO_API_BIND_HOST=127.0.0.1
ZUMBO_API_PORT=58088
ZUMBO_DIRECT_API_URL=http://127.0.0.1:58088
ZUMBO_GATEWAY_BIND_HOST=127.0.0.1
ZUMBO_GATEWAY_PORT=58089
ZUMBO_NOTIFICATION_EXTRACTION_ENABLED=false
ZUMBO_NOTIFICATION_UPSTREAM_BASE_URL=
ZUMBO_GATEWAY_URL=http://127.0.0.1:58089
ZUMBO_API_URL=http://127.0.0.1:58089
ZUMBO_FRONTEND_BIND_HOST=127.0.0.1
ZUMBO_FRONTEND_PORT=58177
ZUMBO_FRONTEND_URL=http://127.0.0.1:58177
ZUMBO_OBSERVABILITY_BIND_HOST=127.0.0.1
ZUMBO_PROMETHEUS_PORT=59090
ZUMBO_GRAFANA_PORT=53000
ZUMBO_GRAFANA_ADMIN_USER=zumbo-local
ZUMBO_GRAFANA_ADMIN_PASSWORD=replace-with-local-observability-password
ZUMBO_DOCKER_SUBNET=10.248.88.0/24

# ProductionLike profile: use registry references pinned to immutable digests.
ZUMBO_API_IMAGE=your-registry.example/zumbo-api@sha256:replace-with-64-hex-digest
ZUMBO_GATEWAY_IMAGE=your-registry.example/zumbo-gateway@sha256:replace-with-64-hex-digest
ZUMBO_PRODUCTION_BIND_HOST=127.0.0.1
ZUMBO_PRODUCTION_HTTPS_PORT=59443
ZUMBO_PRODUCTION_TLS_DIR=./.production-like/tls
ZUMBO_TLS_PFX_PASSWORD=replace-with-at-least-24-random-characters
ZUMBO_MONGO_REPLICA_KEY=replace-with-base64-random-replica-key
ZUMBO_MONGO_ROOT_USERNAME=zumbo_root
ZUMBO_MONGO_ROOT_PASSWORD=replace-with-at-least-24-random-characters
ZUMBO_REDIS_PASSWORD=replace-with-at-least-24-random-characters
ZUMBO_OPENSEARCH_ADMIN_PASSWORD=replace-with-at-least-24-random-characters

# Yalnız docker-compose.host-access.yml ile gereken host araç erişimi.
ZUMBO_INFRA_BIND_HOST=127.0.0.1
ZUMBO_MONGO_HOST_PORT=58217
ZUMBO_REDIS_HOST_PORT=58379
ZUMBO_MINIO_API_HOST_PORT=58400
ZUMBO_MINIO_CONSOLE_HOST_PORT=58401
ZUMBO_OPENSEARCH_HOST_PORT=59200
ZUMBO_MONGO_URL=mongodb://127.0.0.1:58217/?replicaSet=rs0&directConnection=true
ZUMBO_OPENSEARCH_URL=http://127.0.0.1:59200
ZUMBO_POSTGRES_HOST_PORT=58432
ZUMBO_POSTGRES_DATABASE=zumbo
ZUMBO_POSTGRES_USER=zumbo
ZUMBO_POSTGRES_PASSWORD=replace-with-at-least-24-random-characters
ZUMBO_POSTGRES_CONNECTION_STRING=Host=127.0.0.1;Port=58432;Database=zumbo;Username=zumbo;Password=replace-with-at-least-24-random-characters

# PostgreSQL test profili yalnız geçici/loopback entegrasyon koşuları içindir.
ZUMBO_POSTGRES_TEST_DATABASE=zumbo_data004
ZUMBO_POSTGRES_TEST_USER=zumbo_test
ZUMBO_POSTGRES_TEST_PASSWORD=replace-with-local-test-password
ZUMBO_POSTGRES_TEST_PORT=0
# API'yi PostgreSQL ile çalıştırırken ortam değişkeni olarak verilir:
# Persistence__Provider=PostgreSql
# PostgreSql__ConnectionString=Host=127.0.0.1;Port=58432;Database=zumbo;Username=zumbo;Password=replace-with-at-least-24-random-characters

# Yalnız docker-compose.baseline.yml ile gerçek SMTP substitute doğrulaması.
ZUMBO_MAILPIT_BIND_HOST=127.0.0.1
ZUMBO_MAILPIT_HTTP_HOST_PORT=58825
ZUMBO_MAILPIT_SMTP_HOST_PORT=51025

ZUMBO_JWT_SIGNING_KEY=replace-with-at-least-64-random-characters
# Yerel demo oturumu: 24 saat. Uretim profillerinde guvenlik politikaniza gore dusurun.
ZUMBO_ACCESS_TOKEN_MINUTES=1440
# Buyuk yerel demo veri setlerinde baslangic indeksleri icin 5 dakika.
ZUMBO_MONGO_COMMAND_TIMEOUT_SECONDS=300
ZUMBO_MINIO_ROOT_USER=replace-with-local-minio-user
ZUMBO_MINIO_ROOT_PASSWORD=replace-with-at-least-16-random-characters
ZUMBO_ATTACHMENT_SCANNER_PROVIDER=PolicyOnly
ZUMBO_CLAMAV_HOST=clamav
ZUMBO_CLAMAV_PORT=3310
ZUMBO_IDENTITY_ADMIN_EMAIL=admin@zumbo.local
ZUMBO_IDENTITY_BOOTSTRAP_TOKEN=replace-with-one-time-random-token
# Compose production-like kayıt akışı; LocalDemo yalnız ASPNETCORE_ENVIRONMENT=Development için geçerlidir.
ZUMBO_REGISTRATION_PROVISIONING_MODE=ProductionLike
ZUMBO_ORGANIZATION_ARCHIVE_RETENTION_DAYS=90
ZUMBO_PROJECT_ARCHIVE_RETENTION_DAYS=90
ZUMBO_WORK_ITEM_RANK_BATCH_SIZE=100
ZUMBO_WORK_ITEM_RANK_MAX_BATCHES=1000
ZUMBO_WORK_ITEM_SCHEMA_BATCH_SIZE=100
ZUMBO_WORK_ITEM_SCHEMA_MAX_BATCHES=1000
ZUMBO_WORK_ITEM_GRAPH_MAX_DEPTH=64
ZUMBO_WORK_ITEM_GRAPH_MAX_NODES=1000
ZUMBO_WORK_ITEM_GRAPH_MAX_OUTGOING=200
ZUMBO_WORK_ITEM_GRAPH_MAX_RELATIONS=200
ZUMBO_WORK_ITEM_GRAPH_MAX_CHILDREN=200
ZUMBO_SPRINT_BATCH_SIZE=100
ZUMBO_SPRINT_MAX_BATCHES=1000

# Gerektiğinde API ortam değişkenleri olarak ayrıca verilir:
# Notifications__Email__Username=replace-with-smtp-user
# Notifications__Email__Password=replace-with-smtp-password

# Mongo migration işlemleri varsayılan olarak yalnız versioned indeks envanterini doğrular.
# Veri backfill'i önce dry-run ile incelenmeli, sonra bounded batch ile açıkça etkinleştirilmelidir:
# MongoMigrations__DryRun=true
# MongoMigrations__RunDataMigrations=true
# MongoMigrations__BatchSize=100
# MongoMigrations__MaxBatchesPerRun=20
# MongoMigrations__RollbackMigrationId=20260719_002_workitem_rank_backfill

# Durable event worker ayarları. Mongo sağlayıcısı transaction için replica set gerektirir.
# DurableMessaging__BatchSize=50
# DurableMessaging__MaximumAttempts=8
# DurableMessaging__LeaseDuration=00:01:00
# DurableMessaging__BaseRetryDelay=00:00:01
# DurableMessaging__MaximumRetryDelay=00:05:00
# DurableMessaging__RetryJitterRatio=0.2
# DurableMessaging__IdleDelay=00:00:00.500
