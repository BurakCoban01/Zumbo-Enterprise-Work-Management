# Yalnız yerel geliştirme için örnek değerlerdir. Üretimde secret manager kullanın.
ZUMBO_JWT_SIGNING_KEY=replace-with-at-least-64-random-characters
ZUMBO_MINIO_ROOT_USER=replace-with-local-minio-user
ZUMBO_MINIO_ROOT_PASSWORD=replace-with-at-least-16-random-characters
ZUMBO_IDENTITY_ADMIN_EMAIL=admin@zumbo.local
ZUMBO_IDENTITY_BOOTSTRAP_TOKEN=replace-with-one-time-random-token

# Gerektiğinde API ortam değişkenleri olarak ayrıca verilir:
# Notifications__Email__Username=replace-with-smtp-user
# Notifications__Email__Password=replace-with-smtp-password
